APP_NAME="Josh Espinoza"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite (default for dev)
DB_CONNECTION=sqlite
# Uncomment and fill when switching to MariaDB:
# DB_CONNECTION=mariadb
# DB_DATABASE=joshespi
# DB_USERNAME=joshespi
# DB_PASSWORD=change-me-password
# DB_ROOT_PASSWORD=change-me-root   # used by scripts/backup.sh and restore.sh

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Dev: point at local Mailpit (docker extra_hosts: host.docker.internal)
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=intake@joshespi.com
MAIL_FROM_NAME="${APP_NAME}"

# Prod: swap above for Brevo
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-brevo-login@example.com
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_ENCRYPTION=tls

INTAKE_NOTIFY_ADDRESS=you@example.com
